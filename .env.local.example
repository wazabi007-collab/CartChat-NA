# ─── OshiCart Local Development ─────────────────
# Copy this to .env.local and fill in real values

NEXT_PUBLIC_SUPABASE_URL=https://pcseqiaqeiiaiqxqtfmw.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin emails (comma-separated) — users who can access /admin
ADMIN_EMAILS=your-email@example.com
OSHICART_ADMIN_WHATSAPP_NUMBERS=+264810000000

# WhatsApp Cloud API
WHATSAPP_ENABLED=false
WHATSAPP_OTP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=CHANGE_ME
WHATSAPP_ACCESS_TOKEN=CHANGE_ME
WHATSAPP_VERIFY_TOKEN=CHANGE_ME
WHATSAPP_WABA_ID=CHANGE_ME
WHATSAPP_APP_SECRET=CHANGE_ME
CRON_SECRET=CHANGE_ME_MIN_16_CHARS
