# ─── OshiCart Production Environment Variables ─────
# Set these in Vercel Dashboard > Settings > Environment Variables
# NEVER commit real values to git

# ─── Supabase (managed) ─────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://pcseqiaqeiiaiqxqtfmw.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=CHANGE_ME
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME

# ─── Site URL ────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://oshicart.com

# ─── Admin ──────────────────────────────────────
ADMIN_EMAILS=your-admin-email@example.com
OSHICART_ADMIN_WHATSAPP_NUMBERS=+264810000000

# WhatsApp Cloud API
WHATSAPP_ENABLED=false
WHATSAPP_OTP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=CHANGE_ME
WHATSAPP_ACCESS_TOKEN=CHANGE_ME
WHATSAPP_VERIFY_TOKEN=CHANGE_ME
WHATSAPP_WABA_ID=CHANGE_ME
WHATSAPP_APP_SECRET=CHANGE_ME
CRON_SECRET=CHANGE_ME_MIN_16_CHARS

# ─── Twilio (SMS OTP — future) ──────────────────
# TWILIO_ACCOUNT_SID=CHANGE_ME
# TWILIO_AUTH_TOKEN=CHANGE_ME
# TWILIO_MESSAGE_SERVICE_SID=CHANGE_ME
